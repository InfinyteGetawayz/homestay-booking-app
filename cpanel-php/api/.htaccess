RewriteEngine On
RewriteRule ^api/?$ index.php [L,QSA]
RewriteRule ^api/(.*)$ index.php [L,QSA]

# Frontend SPA fallback
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{REQUEST_URI} !^/api$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
